import React, { useRef, useEffect } from "react"
import { Canvas, useFrame } from "@react-three/fiber"
import { useGLTF, useAnimations } from "@react-three/drei"
import * as THREE from "three"

const MOOD_TO_ANIMATION = {
  idle:        "Idle",
  explaining:  "Talking",
  thinking:    "Thinking",
  quiz:        "Thinking",
  happy:       "Happy",
  concerned:   "Sad",
  encouraging: "Talking",
}

const MOOD_TO_EXPRESSION = {
  happy:      { mouthSmile: 0.6 },
  concerned:  { mouthFrownLeft: 0.4, mouthFrownRight: 0.4 },
  thinking:   { browInnerUp: 0.4 },
  explaining: { browOuterUpLeft: 0.2, browOuterUpRight: 0.2 },
  idle:       {},
}

const VISEME_MAP = {
  0: "viseme_sil", 1: "viseme_PP",  2: "viseme_FF",
  3: "viseme_TH",  4: "viseme_DD",  5: "viseme_kk",
  6: "viseme_CH",  7: "viseme_SS",  8: "viseme_nn",
  9: "viseme_RR",  10: "viseme_aa", 11: "viseme_E",
  12: "viseme_I",  13: "viseme_O",  14: "viseme_U",
}

function NovaModel({ moodRef, isSpeakingRef, currentVisemeRef }) {
  const group = useRef()
  const { scene, animations } = useGLTF("/nova.glb")
  const { actions, names } = useAnimations(animations, group)
  const morphMeshesRef = useRef([])
  const currentActionRef = useRef(null)

  useEffect(() => {
    const meshes = []
    scene.traverse(obj => {
      if (obj.isMesh) {
        obj.frustumCulled = false
        if (obj.material) {
          obj.material.side = THREE.DoubleSide
          obj.material.needsUpdate = true
        }
        if (obj.morphTargetDictionary && obj.morphTargetInfluences) {
          meshes.push(obj)
        }
      }
    })
    morphMeshesRef.current = meshes
  }, [scene])

  useEffect(() => {
    if (!actions || names.length === 0) return
    const targetName = MOOD_TO_ANIMATION[moodRef.current] || "Idle"
    const action = actions[targetName] || actions[names[0]]
    if (!action) return
    if (currentActionRef.current && currentActionRef.current !== action) {
      currentActionRef.current.stop()
    }
    action.reset().play()
    currentActionRef.current = action
  }, [actions, names])

  useFrame(() => {
    // Update animation based on current mood ref
    if (actions && names.length > 0) {
      const targetName = MOOD_TO_ANIMATION[moodRef.current] || "Idle"
      const action = actions[targetName] || actions[names[0]]
      if (action && currentActionRef.current !== action) {
        if (currentActionRef.current) currentActionRef.current.fadeOut(0.3)
        action.reset().fadeIn(0.3).play()
        currentActionRef.current = action
      }
    }

    // Update morph targets
    const meshes = morphMeshesRef.current
    if (!meshes.length) return
    const isSpeaking = isSpeakingRef.current
    const visemeName = VISEME_MAP[currentVisemeRef.current] || "viseme_sil"
    const mood = moodRef.current

    meshes.forEach(mesh => {
      try {
        const dict = mesh.morphTargetDictionary
        const inf = mesh.morphTargetInfluences
        if (!dict || !inf) return

        // Decay all visemes
        Object.values(VISEME_MAP).forEach(name => {
          const idx = dict[name]
          if (idx !== undefined && inf[idx] > 0.001) inf[idx] *= 0.6
        })

        // Decay jaw
        const jawIdx = dict["jawOpen"]
        if (jawIdx !== undefined && inf[jawIdx] > 0.001) inf[jawIdx] *= 0.6

        // Apply viseme if speaking
        if (isSpeaking) {
          const vIdx = dict[visemeName]
          if (vIdx !== undefined) inf[vIdx] = Math.min((inf[vIdx] || 0) + 0.4, 1.0)
          if (jawIdx !== undefined) inf[jawIdx] = Math.min((inf[jawIdx] || 0) + 0.1, 0.3)
        }

        // Apply mood expression
        const expr = MOOD_TO_EXPRESSION[mood] || {}
        Object.entries(expr).forEach(([name, target]) => {
          const idx = dict[name]
          if (idx !== undefined) {
            inf[idx] = (inf[idx] || 0) + (target - (inf[idx] || 0)) * 0.05
          }
        })
      } catch (e) {}
    })
  })

  return (
    <group ref={group}>
      <primitive
        object={scene}
        scale={1.0}
        position={[0, -0.9, 0]}
        rotation={[0, 0, 0]}
      />
    </group>
  )
}

// Use refs for frequently changing values to prevent Canvas remounts
const AvatarCanvas = React.memo(function AvatarCanvas({ moodRef, isSpeakingRef, currentVisemeRef }) {
  return (
    <Canvas
      camera={{ position: [0, 0, 3], fov: 60 }}
      style={{ width: "100%", height: "100%" }}
      frameloop="always"
    >
      <ambientLight intensity={1.2} />
      <directionalLight position={[0, 4, 4]} intensity={1.2} />
      <NovaModel
        moodRef={moodRef}
        isSpeakingRef={isSpeakingRef}
        currentVisemeRef={currentVisemeRef}
      />
    </Canvas>
  )
})

export default function Avatar({ mood = "idle", isSpeaking = false, currentViseme = 0 }) {
  // Use refs to pass frequently changing values without causing Canvas remounts
  const moodRef = useRef(mood)
  const isSpeakingRef = useRef(isSpeaking)
  const currentVisemeRef = useRef(currentViseme)

  // Update refs on every render without triggering Canvas re-render
  moodRef.current = mood
  isSpeakingRef.current = isSpeaking
  currentVisemeRef.current = currentViseme

  return (
    <div style={{
      width: "100%", height: "100%", minHeight: "400px",
      background: "linear-gradient(180deg, #EDE9FE 0%, #F0FDF4 100%)",
      position: "relative", overflow: "hidden",
    }}>
      <AvatarCanvas
        moodRef={moodRef}
        isSpeakingRef={isSpeakingRef}
        currentVisemeRef={currentVisemeRef}
      />
      <div style={{
        position: "absolute", bottom: "8px", left: 0, right: 0,
        textAlign: "center", fontSize: "11px", fontWeight: 700,
        color: "#7C3AED", letterSpacing: "1px"
      }}>
        MISS NOVA
      </div>
    </div>
  )
}